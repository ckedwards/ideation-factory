{
  "name": "ideation-factory",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@ideaf/server' dev",
    "test": "bun scripts/worktree.ts exec -- bun test",
    "typecheck": "bun run --filter '*' typecheck && tsc -p scripts",
    "engine:stop": "bun scripts/worktree.ts stop",
    "worktree": "bun scripts/worktree.ts info"
  },
  "devDependencies": {
    "@types/bun": "^1",
    "typescript": "^5"
  }
}
