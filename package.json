{
  "name": "ideation-factory",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "bun run --filter '@ideaf/server' --filter '@ideaf/web' dev",
    "test": "bun scripts/worktree.ts test -- bun test",
    "typecheck": "bun run --filter '*' typecheck && bun check -p scripts",
    "engine:stop": "bun scripts/worktree.ts stop",
    "worktree": "bun scripts/worktree.ts info",
    "lint:commits": "bun scripts/commit-lint.ts --range",
    "lint": "oxlint packages scripts && oxfmt --check packages scripts",
    "format": "bun scripts/format.ts"
  },
  "devDependencies": {
    "@ideaf/api": "workspace:*",
    "@ideaf/core": "workspace:*",
    "@types/bun": "^1",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "^5"
  }
}
