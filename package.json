{
  "name": "ideation-factory",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@ideaf/server' dev",
    "test": "RIVETKIT_STORAGE_PATH=.data bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "engine:stop": "pkill -x rivet-engine; pkill -x rivet-services; true"
  },
  "devDependencies": {
    "@types/bun": "^1",
    "typescript": "^5"
  }
}
