# The load balancer in front of the three app nodes: TLS (TLS_MODE, see
# tls.caddy), and requests spread round-robin over the nodes in
# APP_NODES that answer their health check. Any node can serve any request:
# the engines route each actor call to wherever that actor runs.

{
	servers {
		# proxies in front of this one (a CDN, say, or a load test's machine) whose X-Forwarded-For is
		# believed and passed on; nobody else's (LB_TRUSTED_PROXIES, by default only this machine)
		trusted_proxies static {$LB_TRUSTED_PROXIES}
	}
}

import /etc/caddy/tls.caddy

{$IDEAF_HOST} {
	import tls-{$TLS_MODE}
	header Strict-Transport-Security "max-age=31536000"
	# an upload is a whole idea's files: the app's own cap (MAX_MESSAGE_BYTES, server/src/limits.ts)
	request_body {
		max_size 16MB
	}
	reverse_proxy {$APP_NODES} {
		lb_policy round_robin
		# a node that's down, or still waiting for its engine, gets nothing
		health_uri /health
		health_interval 5s
		health_timeout 2s
		# a request that couldn't reach a node goes to another (safe: writes carry idempotency keys)
		lb_try_duration 10s
		fail_duration 30s
	}
}
