# The TLS modes, shared by the load deployment's Caddyfiles (lb.yaml, try-locally.yaml): TLS_MODE picks one.
#   internal       Caddy's own local CA: for trying it out (browsers warn)
#   files          /tls/fullchain.pem and /tls/privkey.pem: yours, an internal CA's, say
#   acme           from ACME_SERVER (Let's Encrypt by default), renewed automatically
#   acme-internal  the same from an internal ACME server (step-ca, say), trusting
#                  its root, /ca/$ACME_CA_FILE
(tls-internal) {
	tls internal
}
(tls-files) {
	tls /tls/fullchain.pem /tls/privkey.pem
}
(tls-acme) {
	tls {$ACME_EMAIL} {
		ca {$ACME_SERVER}
	}
}
(tls-acme-internal) {
	tls {$ACME_EMAIL} {
		ca {$ACME_SERVER}
		ca_root /ca/{$ACME_CA_FILE}
	}
}
