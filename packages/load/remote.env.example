# The load test against a deployment (remote.sh, DEPLOYMENT.md). Copy to .data/remote.env and fill in.

# The deployment, through its load balancer: its public URL
LOAD_URLS=https://ideas.example.com
LOAD_ORIGIN=https://ideas.example.com
# The load balancer's private address, which the URL's name resolves to here (put the same in
# /etc/hosts, for the seeder: "10.0.0.10 ideas.example.com")
LOAD_LB_ADDRESS=10.0.0.10
# 1 if its certificate is from Caddy's internal CA (TLS_MODE=internal)
LOAD_INSECURE_TLS=0

# This machine's private address: the nodes send sign-in codes to Mailpit here (their
# email.smtp_url is smtp://<this address>:1025)
LOAD_PRIVATE_ADDRESS=10.0.0.20

# The nodes, by private address, for CPU and memory over SSH (keys set up beforehand)
NODES="10.0.0.11 10.0.0.12 10.0.0.13"
# ubuntu on AWS's Ubuntu images; root on Hetzner's
SSH_USER=ubuntu
