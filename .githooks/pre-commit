#!/bin/sh
# Checks what's staged before it's committed. `bun install` turns this folder
# on as the hooks.
#
# - The code's style (TypeScript, JSON and CSS): oxlint for the rules (braces
#   around every body), oxfmt for layout. `bun run format` fixes what it reports.
# - A changed workflow: every action it uses is pinned in
#   .github/workflows/actions.lock. `gh actions-lock` updates it.
# - No secrets: Betterleaks over what's staged (scripts/secrets.sh, .betterleaks.toml).
cd "$(git rev-parse --show-toplevel)" || exit 1

scripts/secrets.sh staged || {
  echo "Remove the secret above from what's staged (and revoke it if it was ever pushed), or if it isn't one, add an exception to .betterleaks.toml saying why; then commit again." >&2
  exit 1
}

workflows=$(git diff --cached --name-only --diff-filter=ACMR -- '.github/workflows/*.yml' '.github/workflows/*.yaml')
if [ -n "$workflows" ]; then
  if ! gh actions-lock --help >/dev/null 2>&1; then
    echo "A workflow changed, but gh actions-lock isn't installed to check .github/workflows/actions.lock." >&2
    echo "Install it (gh extension install github/gh-actions-lock), run gh actions-lock, stage the lockfile, then commit again." >&2
    exit 1
  fi
  # the check reads the files on disk, so the lockfile on disk must be the one being committed
  if ! git diff --quiet -- .github/workflows/actions.lock; then
    echo "Stage .github/workflows/actions.lock too (git add .github/workflows/actions.lock), then commit again." >&2
    exit 1
  fi
  gh actions-lock --verify-local || {
    echo "Run gh actions-lock to pin the new actions, stage .github/workflows/actions.lock, then commit again." >&2
    exit 1
  }
fi

files=$(git diff --cached --name-only --diff-filter=ACMR -- 'packages/**/*.ts' 'packages/**/*.tsx' 'scripts/**/*.ts' 'packages/**/*.json' 'scripts/**/*.json' 'packages/**/*.css')
[ -z "$files" ] && exit 0
ts=$(printf '%s\n' $files | grep -E '\.tsx?$')
# each tool skips what its config ignores (generated files); left with nothing, that's not an error
# shellcheck disable=SC2086
[ -z "$ts" ] || bunx oxlint --no-error-on-unmatched-pattern $ts || { echo "Fix the lint errors above (bun run format fixes most), then commit again." >&2; exit 1; }
# shellcheck disable=SC2086
bunx oxfmt --check --no-error-on-unmatched-pattern $files || { echo "Run bun run format, stage the result, then commit again." >&2; exit 1; }
