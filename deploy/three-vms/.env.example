# Copy to .env on each VM and on the load balancer. The same everywhere except NODE_ADDRESS.
# Secrets: openssl rand -hex 32

IDEAF_HOST=ideas.example.com
IDEAF_URL=https://ideas.example.com
IDEAF_AUTH_SECRET=
RIVET_ADMIN_TOKEN=
IDEAF_SITE_ADMINS=you@example.com

# The app's version, the same on every VM and higher with each deploy: the commit's time is a good one
# (git log -1 --format=%ct). The engine sends actors only to the highest version it sees.
RIVET_NODE_VERSION=

# Each VM: its own private address. The load balancer: the three apps, and its own addresses for the VMs.
NODE_ADDRESS=10.0.0.11
APP_NODES=10.0.0.11:8080 10.0.0.12:8080 10.0.0.13:8080
LB_ADDRESSES=10.0.0.10

# The bucket, outside the VMs: your cloud's, or a SeaweedFS you run separately. Make both buckets first.
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
# A key for each bucket, each allowed only its own (deploy/README.md): the engine's, and the app's files'
S3_ENGINE_ACCESS_KEY_ID=
S3_ENGINE_SECRET_ACCESS_KEY=
S3_FILES_ACCESS_KEY_ID=
S3_FILES_SECRET_ACCESS_KEY=
# S3_FILES_BUCKET=ideaf-files
# S3_ENGINE_BUCKET=ideaf-engine
# S3_ALLOW_HTTP=true          (a store on plain HTTP, on the private network)

# Email
IDEAF_SMTP_URL=smtps://user:password@smtp.example.com:465
IDEAF_EMAIL_FROM=Ideation Factory <sign-in@example.com>
IDEAF_NOTIFY_FROM=Ideation Factory <notifications@example.com>

# TLS, on the load balancer: internal, files, acme or acme-internal (see ../caddy/tls.caddy)
TLS_MODE=acme
ACME_EMAIL=you@example.com
# ACME_SERVER=https://ca.internal.example.com/acme/acme/directory
# ACME_CA_FILE=internal-ca.pem
