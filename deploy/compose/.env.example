# Trying Ideation Factory with Docker Compose (README.md): cp .env.example .env, then fill in these.

# Two secrets: openssl rand -hex 32 for each
IDEAF_AUTH_SECRET=
RIVET_ADMIN_TOKEN=

# Your email: you sign in with it, as a site admin
IDEAF_SITE_ADMINS=you@example.com

# Optional:
# where people reach it, if not http://localhost:8080 (and the port on this machine)
# IDEAF_URL=http://localhost:8080
# IDEAF_PORT=8080
# a release (v0.1.<n>), master, or sha-<commit>; the newest release unless set
# IDEAF_VERSION=latest
# email for real, through a relay you have, in place of codes in the log
# IDEAF_SMTP_URL=smtps://user:password@smtp.example.com:465
# IDEAF_EMAIL_FROM=Ideation Factory <sign-in@example.com>
