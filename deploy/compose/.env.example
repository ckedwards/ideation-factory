# Trying Ideation Factory with Docker Compose (README.md). ./create-env.sh writes .env from this,
# with new secrets and the admin's email; or cp .env.example .env and fill them in yourself.

# Two secrets: openssl rand -hex 32 for each
IDEAF_AUTH_SECRET=
RIVET_ADMIN_TOKEN=

# The site admin's email, to sign in with. Sign-in codes go to Mailpit (http://localhost:8025), not
# to anyone's inbox, so any address will do.
IDEAF_SITE_ADMINS=admin@example.com

# Optional:
# where people reach it, if not http://localhost:8080 (and the port on this machine)
# IDEAF_URL=http://localhost:8080
# IDEAF_PORT=8080
# a release (v0.1.<n>), master, or sha-<commit>; the newest release unless set
# IDEAF_VERSION=latest
# Mailpit's port on this machine
# MAILPIT_PORT=8025
# email for real, through a relay you have, in place of Mailpit
# IDEAF_SMTP_URL=smtps://user:password@smtp.example.com:465
# IDEAF_EMAIL_FROM=Ideation Factory <sign-in@example.com>
# IDEAF_NOTIFY_FROM=Ideation Factory <notifications@example.com>
