# The TLS proxy in front of the app, on one VM. TLS_MODE picks the certificate
# (see ../caddy/tls.caddy): internal, files, acme or acme-internal.
import /etc/caddy/tls.caddy

{$IDEAF_HOST} {
	import tls-{$TLS_MODE}
	header Strict-Transport-Security "max-age=31536000"
	# an upload is a whole idea's files; the app checks its own limits
	request_body {
		max_size 64MB
	}
	# WebSockets (live updates) and X-Forwarded-For pass through as they are
	reverse_proxy app:8080
}
