# Copy to .env and fill in. Secrets: openssl rand -hex 32

# The name people reach it by, and its public URL
IDEAF_HOST=ideas.example.com
IDEAF_URL=https://ideas.example.com
# HTTP_PORT=80
# HTTPS_PORT=443

IDEAF_AUTH_SECRET=
RIVET_ADMIN_TOKEN=
IDEAF_SITE_ADMINS=you@example.com

# The bucket: SeaweedFS here (the seaweedfs profile), or your cloud's (drop the profile, set S3_ENDPOINT,
# and make the two buckets yourself)
COMPOSE_PROFILES=seaweedfs
# A key for each bucket, each allowed only its own (deploy/README.md): the engine's, and the app's files'
S3_ENGINE_ACCESS_KEY_ID=engine
S3_ENGINE_SECRET_ACCESS_KEY=
S3_FILES_ACCESS_KEY_ID=files
S3_FILES_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_FILES_BUCKET=ideaf-files
# S3_ENGINE_BUCKET=ideaf-engine

# Email: sign-in codes and notifications
IDEAF_SMTP_URL=smtps://user:password@smtp.example.com:465
IDEAF_EMAIL_FROM=Ideation Factory <sign-in@example.com>
IDEAF_NOTIFY_FROM=Ideation Factory <notifications@example.com>

# TLS (see the Caddyfile): TLS_MODE is
#   internal       Caddy's own local CA, for trying it out (the default; browsers warn)
#   files          your certificate in ./tls (fullchain.pem, privkey.pem): an internal CA's, say
#   acme           from Let's Encrypt (or ACME_SERVER), got and renewed automatically
#   acme-internal  from an internal ACME server (step-ca, say), its root CA in ./ca/ACME_CA_FILE
TLS_MODE=acme
ACME_EMAIL=you@example.com
# ACME_SERVER=https://ca.internal.example.com/acme/acme/directory
# ACME_CA_FILE=internal-ca.pem

# An internal CA's certificates in ./ca (*.pem or *.crt) are trusted for the app's own connections
# (single sign-on, SMTP, the bucket).
