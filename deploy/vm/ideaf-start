#!/bin/sh
# Starts the app (or, with RIVET_POOL=directory, the directory) from its install in /opt/ideaf, as the
# image's entrypoint does: the node version from the build unless RIVET_NODE_VERSION is set, and any
# internal CA certificates in /etc/ideaf/ca trusted for its own connections. exec, so systemd's SIGTERM
# reaches the server itself.
set -e
APP=/opt/ideaf/app
if [ -z "$RIVET_NODE_VERSION" ] && [ -s "$APP/build-version" ]; then
  RIVET_NODE_VERSION="$(cat "$APP/build-version")"
  export RIVET_NODE_VERSION
fi
extra=/var/lib/ideaf/extra-ca.pem
: > "$extra"
for certificate in /etc/ideaf/ca/*.pem /etc/ideaf/ca/*.crt; do
  if [ -f "$certificate" ]; then
    cat "$certificate" >> "$extra"
  fi
done
if [ -s "$extra" ]; then
  export NODE_EXTRA_CA_CERTS="$extra"
fi
export IDEAF_DATA="${IDEAF_DATA:-/var/lib/ideaf}"
export IDEAF_WEB_DIR="${IDEAF_WEB_DIR:-$APP/packages/web/dist}"
cd "$APP"
exec /opt/ideaf/bin/bun packages/server/src/main.ts
