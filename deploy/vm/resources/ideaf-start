#!/bin/sh
# Starts the app (or, with IDEAF__ENGINE__POOL=directory, the directory) from its install in
# /opt/ideaf, as the image's entrypoint does: any internal CA certificates in /etc/ideaf/ca trusted for
# its own connections, and its settings from /etc/ideaf/ideaf.yaml and secrets.yaml, which it reads
# itself. exec, so systemd's SIGTERM reaches the server itself.
set -e
APP=/opt/ideaf/app
extra=/var/lib/ideaf/extra-ca.pem
: > "$extra"
for certificate in /etc/ideaf/ca/*.pem /etc/ideaf/ca/*.crt; do
  if [ -f "$certificate" ]; then
    cat "$certificate" >> "$extra"
  fi
done
if [ -s "$extra" ]; then
  export NODE_EXTRA_CA_CERTS="$extra"
fi
export IDEAF__DATA="${IDEAF__DATA:-/var/lib/ideaf}"
export IDEAF__WEB__DIR="${IDEAF__WEB__DIR:-$APP/packages/web/dist}"
cd "$APP"
exec /opt/ideaf/bin/bun packages/server/src/main.ts
