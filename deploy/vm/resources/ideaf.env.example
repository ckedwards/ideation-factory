# /etc/ideaf/ideaf.env: the app's and the directory's settings (deploy/vm/README.md), the same on every
# machine. Readable by root and the ideaf group only. Secrets: openssl rand -hex 32

# The public URL, through the load balancer
IDEAF_URL=https://ideas.example.com
IDEAF_AUTH_SECRET=
IDEAF_SITE_ADMINS=you@example.com
# the load balancer's private addresses (comma-separated): only it is believed about who the client is
IDEAF_TRUSTED_PROXIES=10.0.0.10

# This machine's engine: its admin token (the same as in /etc/rivet/config.json), twice
RIVET_ADMIN_TOKEN=
RIVET_ENDPOINT=http://default:<the admin token>@127.0.0.1:6420
# The directory runs in a pool of its own (one machine's directory process hosts it)
IDEAF_DIRECTORY_POOL=directory
# With several machines: the same on all of them, higher with each upgrade (the build's own unless set)
# RIVET_NODE_VERSION=

# The files bucket, and a key allowed only it: s3:GetObject and s3:PutObject on its objects, and
# s3:ListBucket on the bucket
IDEAF_S3_BUCKET=
IDEAF_S3_REGION=us-east-1
IDEAF_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
IDEAF_S3_ACCESS_KEY_ID=
IDEAF_S3_SECRET_ACCESS_KEY=

# Email: this machine's sendmail (its mail setup relays it), or SMTP to a provider or relay
IDEAF_EMAIL=sendmail
# IDEAF_SENDMAIL=/usr/sbin/sendmail
# IDEAF_SMTP_URL=smtps://user:password@smtp.example.com:465
IDEAF_EMAIL_FROM=Ideation Factory <sign-in@example.com>
IDEAF_NOTIFY_FROM=Ideation Factory <notifications@example.com>
