# yaml-language-server: $schema=https://raw.githubusercontent.com/ckedwards/ideation-factory/master/deploy/ideaf.schema.json
#
# /etc/ideaf/secrets.yaml: the secrets, readable by root and the ideaf group only, the same on every
# machine. Only secrets go here (the app refuses anything else); new ones: openssl rand -hex 32.

auth:
  # signs cookies and encrypts the signing keys: at least 32 characters
  secret:

engine:
  # the engine's admin token, the same as auth.admin_token in /etc/rivet/config.json
  token:

files:
  s3:
    # the files bucket's key's secret
    secret_access_key:

# email:
#   smtp_url: smtps://user:password@smtp.example.com:465
